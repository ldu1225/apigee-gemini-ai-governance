<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ProxyEndpoint name="default">
    <Description>Apigee AI Gateway Proxy Endpoint with Department x Model RBAC &amp; BigQuery Chargeback</Description>
    <PreFlow name="PreFlow">
        <Request>
            <Step>
                <Name>EV-ExtractModelAndDept</Name>
            </Step>
            <Step>
                <Name>RF-UnauthorizedModel403</Name>
                <Condition>(apigee.dept_token = "dept-b-quality-token-2026") and (apigee.req.model = "gemini-3.1-pro")</Condition>
            </Step>
        </Request>
        <Response/>
    </PreFlow>
    <PostFlow name="PostFlow">
        <Request/>
        <Response>
            <Step>
                <Name>SC-BigQueryLogUsage</Name>
            </Step>
        </Response>
    </PostFlow>
    <HTTPProxyConnection>
        <BasePath>/v1/models</BasePath>
        <VirtualHost>secure</VirtualHost>
    </HTTPProxyConnection>
    <RouteRule name="default">
        <TargetEndpoint>default</TargetEndpoint>
    </RouteRule>
</ProxyEndpoint>
